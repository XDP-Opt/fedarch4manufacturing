# Zotero library holding the review corpus (read access is enough).
ZOTERO_LIBRARY_ID=your_library_id_here
ZOTERO_API_KEY=your_api_key_here
ZOTERO_LIBRARY_TYPE=group

# Collection within that library that holds the abstracts to screen.
ZOTERO_COLLECTION=your_collection_key_here

# Ollama server serving the screening model.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:14b
